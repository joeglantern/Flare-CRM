# Host nginx in front of one CRM stack (docs/12 §10). Copy to /etc/nginx/sites-available/<name>,
# symlink into sites-enabled, then `sudo certbot --nginx -d crm.example.com`.
#
# Everything this file does is transport: terminate TLS, pass the real client address, and keep
# websockets open. The application's own headers, CSP and cache rules come from the stack's Caddy,
# so there is deliberately no security header here. Adding one would give the browser two.
server {
    listen 80;
    listen [::]:80;
    server_name crm.example.com;
    # certbot rewrites this to a redirect once the certificate exists.
    location / {
        proxy_pass http://127.0.0.1:8090;
        include /etc/nginx/proxy_params;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name crm.example.com;

    # certbot fills these in.
    # ssl_certificate     /etc/letsencrypt/live/crm.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/crm.example.com/privkey.pem;

    # Recordings and CSV imports go through here.
    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Socket.IO: the upgrade headers and a long read timeout, or a live fleet screen dies every
        # sixty seconds and reconnects.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # Server-sent progress on imports and exports must not be buffered into silence.
        proxy_buffering off;
    }
}

{
	email {$ACME_EMAIL}
	# Caddy only trusts X-Forwarded-* from these; everything else is replaced with the real client IP
	servers {
		trusted_proxies static private_ranges
	}
}

{$CRM_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		-Server
	}

	@api path /api/* /socket.io/* /webhooks/* /public/* /health /ready
	handle @api {
		reverse_proxy api:4000 {
			header_up X-Request-Start {time.now.unix_ms}
			flush_interval -1
		}
	}

	handle {
		root * /srv/web
		header Content-Security-Policy "default-src 'self'; connect-src 'self' wss://{$CRM_DOMAIN} https://{$CRM_DOMAIN}; img-src 'self' data: blob:; media-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Brand images and PWA icons are not content-hashed, so they cannot be immutable, but with no
		# Cache-Control at all the browser revalidated every illustration and avatar on every page.
		# A week, then a cheap ETag check.
		@brand path /brand/* /icon-*.png /apple-touch-icon.png /maskable-512.png /favicon.svg
		header @brand Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
		header /index.html Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /data/access.log {
			roll_size 50mb
			roll_keep 10
		}
		format json
	}
}

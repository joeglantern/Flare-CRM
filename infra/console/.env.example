# Owner console (docs/21). Copy to .env on the console host and fill in.
# This file is the only place the signing key exists. Losing it means every customer stack has to
# be issued a document signed by a new key before it will trust anything from here again.

NODE_ENV=production
CONSOLE_DOMAIN=console.raniafrica.co.ke
CONSOLE_URL=https://console.raniafrica.co.ke
ACME_EMAIL=ops@raniafrica.co.ke

API_HOST=0.0.0.0
API_PORT=4100
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

# openssl rand -base64 48
CONSOLE_AUTH_SECRET=
# openssl rand -hex 32
CONSOLE_SECRETS_KEY=
# node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
CONSOLE_SIGNING_KEY=

# Customers get <slug>.<this>; a wildcard A record for it points here or at their own servers.
CONSOLE_BRAND_DOMAIN=raniafrica.co.ke

# The password in these two matches secrets/postgres_password and secrets/valkey_password.
CONSOLE_DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/console?schema=public
CONSOLE_VALKEY_URL=redis://:CHANGE_ME@valkey:6379/0

# Password links and owner invitations go out over this.
SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM="Flare Console <console@raniafrica.co.ke>"

# The first owner, created by `docker compose run --rm create-owner <email> "<name>"`.
FIRST_OWNER_EMAIL=you@raniafrica.co.ke
FIRST_OWNER_NAME=Your Name

# Images, set by deploy.sh or by hand.
CONSOLE_IMAGE=ghcr.io/OWNER/crm-console-api
CONSOLE_WEB_IMAGE=ghcr.io/OWNER/crm-console-web:latest
IMAGE_TAG=latest

METRICS_ENABLED=false
OPENAPI_ENABLED=false
BACKUP_CRON=30 2 * * *

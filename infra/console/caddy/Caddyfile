{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

{$CONSOLE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "microphone=(), camera=(), geolocation=()"
		-Server
	}

	# /api/link/* is how customer stacks reach us: bearer credentials, no session, no browser.
	@api path /api/* /socket.io/* /health /ready
	handle @api {
		reverse_proxy api:4100 {
			header_up X-Request-Start {time.now.unix_ms}
			flush_interval -1
		}
	}

	handle {
		root * /srv/console
		header Content-Security-Policy "default-src 'self'; connect-src 'self' wss://{$CONSOLE_DOMAIN} https://{$CONSOLE_DOMAIN}; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /data/access.log {
			roll_size 50mb
			roll_keep 10
		}
		format json
	}
}

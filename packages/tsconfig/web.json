{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    // React props are routinely spread as `prop: value | undefined`; exactOptionalPropertyTypes
    // fights JSX everywhere without buying safety in a UI layer. The API keeps it on.
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  }
}

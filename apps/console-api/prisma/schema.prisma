// Owner console data model — see docs/21. Column names are snake_case via @map.
// This database belongs to the provider, not to any customer, and holds no customer CRM data:
// only who the customers are, what they are entitled to, and how their stacks check in.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Auth (Better Auth core + admin + twoFactor) ─────────────────────────────
// Owners only. There is no sign-up: the first owner comes from the seed, the rest are invited.

model User {
  id               String    @id @db.Uuid
  name             String
  email            String    @unique @db.Citext
  emailVerified    Boolean   @default(false) @map("email_verified")
  image            String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  role             String?   @default("owner")
  banned           Boolean?  @default(false)
  banReason        String?   @map("ban_reason")
  banExpires       DateTime? @map("ban_expires") @db.Timestamptz(3)
  twoFactorEnabled Boolean?  @default(false) @map("two_factor_enabled")
  isActive         Boolean   @default(true) @map("is_active")
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(3)

  sessions   Session[]
  accounts   Account[]
  twofactors TwoFactor[]

  @@index([role])
  @@map("users")
}

model Session {
  id             String   @id @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  token          String   @unique
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  issuer                String
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model TwoFactor {
  id                      String    @id @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

// ───────────────────────────── Customers and their plans ─────────────────────────────

model Customer {
  id           String    @id @db.Uuid
  name         String
  /// Lowercase, used as the subdomain: <slug>.<CONSOLE_BRAND_DOMAIN>
  slug         String    @unique
  status       String    @default("active")
  contactName  String    @map("contact_name")
  contactEmail String    @map("contact_email")
  contactPhone String?   @map("contact_phone")
  notes        String    @default("")
  primaryDomain String   @unique @map("primary_domain")
  /// A domain the customer owns, pointed here with a CNAME once verified.
  customDomain           String?   @unique @map("custom_domain")
  customDomainToken      String?   @map("custom_domain_token")
  customDomainVerifiedAt DateTime? @map("custom_domain_verified_at") @db.Timestamptz(3)
  /// Set while the provider is holding this customer read only, and cleared when it is lifted.
  suspendedAt  DateTime? @map("suspended_at") @db.Timestamptz(3)
  /// Filed away: out of the fleet by default, every row kept. Deliberately not a status, because
  /// status is what their own CRM enforces and archiving is only what we have stopped doing.
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  archivedById  String?   @map("archived_by_id") @db.Uuid
  archiveReason String?   @map("archive_reason")
  churnReason   String?   @map("churn_reason")
  churnedAt     DateTime? @map("churned_at") @db.Timestamptz(3)
  /// How far along setting them up is, in the part only a person knows.
  onboardingStage     String @default("signed_up") @map("onboarding_stage")
  onboardingChecklist Json   @default("{}") @map("onboarding_checklist")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  entitlement   CustomerEntitlement?
  stacks        Stack[]
  issues        EntitlementIssue[]
  alerts        ConsoleAlert[]
  announcements Announcement[]
  contacts      CustomerContact[]
  noteEntries   CustomerNote[]

  @@index([status])
  @@index([archivedAt])
  @@index([status, archivedAt])
  @@map("customers")
}

/// Somebody at the customer worth being able to ring. The contact on `customers` is the one we
/// bill and the one carried into a signed document; these are everybody else.
model CustomerContact {
  id         String   @id @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  name       String
  email      String   @default("")
  phone      String?
  /// What they do there, in their own words rather than a fixed list.
  role       String   @default("")
  isPrimary  Boolean  @default(false) @map("is_primary")
  notes      String   @default("")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isPrimary])
  @@map("customer_contacts")
}

/// What happened with this customer, written down at the time. The `notes` column on `customers` is
/// one standing paragraph; these are dated entries that accumulate.
model CustomerNote {
  id         String   @id @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  body       String
  authorId   String?  @map("author_id") @db.Uuid
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt(sort: Desc)])
  @@map("customer_notes")
}

model Plan {
  id          String   @id @db.Uuid
  name        String   @unique
  description String   @default("")
  /// Feature map from packages/shared; overrides on a customer are layered on top.
  features    Json
  limits      Json
  /// What this plan costs a month, in minor units of `currency`. Null means it is not sold.
  priceMonthlyMinor Int?    @map("price_monthly_minor")
  currency          String  @default("KES")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  entitlements CustomerEntitlement[]

  @@map("plans")
}

model CustomerEntitlement {
  customerId       String    @id @map("customer_id") @db.Uuid
  planId           String?   @map("plan_id") @db.Uuid
  /// Only the keys that differ from the plan; absent means inherit.
  featureOverrides Json      @default("{}") @map("feature_overrides")
  limitOverrides   Json      @default("{}") @map("limit_overrides")
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(3)
  /// What the expiry was before a suspension, so lifting one restores it rather than granting forever.
  expiresAtBeforeSuspension DateTime? @map("expires_at_before_suspension") @db.Timestamptz(3)
  /// What this customer actually pays, when it differs from the plan.
  priceMonthlyMinorOverride Int? @map("price_monthly_minor_override")
  agreementNotes   String    @default("") @map("agreement_notes")
  updatedById      String?   @map("updated_by_id") @db.Uuid
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan     Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@map("customer_entitlements")
}

// ───────────────────────────── Stacks and what they have been issued ─────────────────────────────

model Stack {
  /// "stk_" plus twenty base32 characters; the customer stack carries it as CONSOLE_STACK_ID.
  id             String    @id
  customerId     String    @map("customer_id") @db.Uuid
  /// Hash of the secret. The secret itself is shown once, at creation, and never stored.
  secretHash     String    @map("secret_hash")
  label          String    @default("primary")
  /// Whatever an operator needs to remember about this particular server.
  notes          String    @default("")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  rotatedAt      DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(3)
  connected      Boolean   @default(false)
  version        String?
  domain         String?
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  health         Json?
  usage          Json?
  lastBackupAt   DateTime? @map("last_backup_at") @db.Timestamptz(3)
  currentIssueId String?   @map("current_issue_id")

  customer Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  issues   EntitlementIssue[]
  samples  StackSample[]
  days     StackDay[]

  @@index([customerId])
  @@index([connected])
  @@index([revokedAt])
  @@map("stacks")
}

model EntitlementIssue {
  /// "iss_" plus a uuid; the stack echoes it back when it acknowledges.
  id            String    @id
  customerId    String    @map("customer_id") @db.Uuid
  stackId       String    @map("stack_id")
  envelope      Json
  payload       Json
  /// The owner who issued it, or null when the machine did: the register and issue scripts
  /// run before anyone can sign in, and must not put a person's name against their work.
  issuedById    String?   @map("issued_by_id") @db.Uuid
  issuedAt      DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(3)
  ackedAt       DateTime? @map("acked_at") @db.Timestamptz(3)
  status        String    @default("pending")
  rejectReason  String?   @map("reject_reason")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stack    Stack    @relation(fields: [stackId], references: [id], onDelete: Cascade)

  @@index([customerId, issuedAt(sort: Desc)])
  @@index([stackId, status])
  @@map("entitlement_issues")
}

/// One measurement of a stack, taken from a heartbeat at most every five minutes (docs/21 §8).
/// Nothing here describes a customer's business: seats, bytes, health and version.
model StackSample {
  id               String   @id @db.Uuid
  stackId          String   @map("stack_id")
  customerId       String   @map("customer_id") @db.Uuid
  at               DateTime @db.Timestamptz(3)
  seatsActive      Int      @map("seats_active")
  storageBytes     BigInt   @map("storage_bytes")
  attachmentsBytes BigInt   @map("attachments_bytes")
  recordingsBytes  BigInt   @map("recordings_bytes")
  backupsBytes     BigInt   @map("backups_bytes")
  readyOk          Boolean  @map("ready_ok")
  version          String
  lastBackupAt     DateTime? @map("last_backup_at") @db.Timestamptz(3)

  stack Stack @relation(fields: [stackId], references: [id], onDelete: Cascade)

  @@index([stackId, at(sort: Desc)])
  @@index([customerId, at(sort: Desc)])
  @@index([at])
  @@map("stack_samples")
}

/// A stack's day, rolled up from its samples so a month of charts is thirty rows and not eight
/// thousand. Rewritten in place while the day is still running.
model StackDay {
  stackId          String   @map("stack_id")
  customerId       String   @map("customer_id") @db.Uuid
  day              DateTime @db.Date
  samples          Int
  connectedMinutes Int      @map("connected_minutes")
  seatsMax         Int      @map("seats_max")
  seatsAvg         Int      @map("seats_avg")
  storageMaxBytes  BigInt   @map("storage_max_bytes")
  readyFailures    Int      @map("ready_failures")
  versions         String[]
  backupSeenAt     DateTime? @map("backup_seen_at") @db.Timestamptz(3)

  stack Stack @relation(fields: [stackId], references: [id], onDelete: Cascade)

  @@id([stackId, day])
  @@index([customerId, day])
  @@map("stack_days")
}

/// The whole fleet's day: what the overview draws its lines from, money included.
model FleetDay {
  day            DateTime @id @db.Date
  customers      Int
  customersLive  Int      @map("customers_live")
  seatsUsed      Int      @map("seats_used")
  seatsSold      Int      @map("seats_sold")
  storageBytes   BigInt   @map("storage_bytes")
  mrrMinor       Int      @map("mrr_minor")
  currency       String   @default("KES")

  @@map("fleet_days")
}

/// Something an owner should look at. One open row per kind per customer is the deduplication:
/// a stack that is offline for a day is one alert, not two thousand emails.
model ConsoleAlert {
  id             String    @id @db.Uuid
  kind           String
  level          String
  customerId     String    @map("customer_id") @db.Uuid
  stackId        String?   @map("stack_id")
  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(3)
  lastNotifiedAt DateTime? @map("last_notified_at") @db.Timestamptz(3)
  context        Json      @default("{}")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, kind, resolvedAt])
  @@index([resolvedAt, openedAt(sort: Desc)])
  @@map("console_alerts")
}

/// What was announced to a customer, so the tab remembers it after a reload.
model Announcement {
  id         String   @id @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  message    String
  level      String
  delivered  Int
  sentById   String   @map("sent_by_id") @db.Uuid
  sentAt     DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, sentAt(sort: Desc)])
  @@map("announcements")
}

model ConsoleSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("console_settings")
}

// Append-only, same rule as the CRM's own log (docs/08 §K1).
model AuditLog {
  id        String   @id @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  actorType String   @default("user") @map("actor_type")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  userAgent String?  @map("user_agent")
  requestId String?  @map("request_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

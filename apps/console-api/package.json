{
  "name": "@crm/console-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Owner console backend: customers, plans, entitlements and the stack link",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/entry/api.ts",
    "build": "pnpm prisma:generate && tsc --noEmit && tsup",
    "start": "node --enable-source-maps dist/entry/api.js",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts"
  },
  "dependencies": {
    "@crm/shared": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/under-pressure": "9.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@socket.io/redis-adapter": "8.3.0",
    "better-auth": "1.7.2",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "5.11.1",
    "nodemailer": "9.1.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "prisma": "7.10.0",
    "socket.io": "4.8.3",
    "uuid": "14.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.1.3",
    "socket.io-client": "4.8.3",
    "testcontainers": "12.1.0",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}

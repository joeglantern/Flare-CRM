// CRM data model — see docs/05-data-model.md. Column names are snake_case via @map.
// Hand-written SQL (partial unique indexes, tsvector triggers, CHECKs, audit immutability)
// lives in prisma/migrations/*/migration.sql next to the generated DDL.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Auth (Better Auth core + admin + twoFactor) ─────────────────────────────

model User {
  id               String    @id @db.Uuid
  name             String
  email            String    @unique @db.Citext
  emailVerified    Boolean   @default(false) @map("email_verified")
  image            String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  // admin plugin
  role             String?   @default("agent")
  banned           Boolean?  @default(false)
  banReason        String?   @map("ban_reason")
  banExpires       DateTime? @map("ban_expires") @db.Timestamptz(3)
  // twoFactor plugin
  twoFactorEnabled Boolean?  @default(false) @map("two_factor_enabled")
  // CRM additional fields (docs/07 §1)
  extension        String?   @unique
  teamId           String?   @map("team_id") @db.Uuid
  phone            String?
  timezone         String    @default("Africa/Nairobi")
  locale           String    @default("en")
  isActive         Boolean   @default(true) @map("is_active")
  avatarKey        String?   @map("avatar_key")
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(3)

  team             Team?              @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  managedTeams     Team[]             @relation("TeamManager")
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]
  ownedContacts    Contact[]          @relation("ContactOwner")
  ownedCompanies   Company[]          @relation("CompanyOwner")
  ownedLeads       Lead[]             @relation("LeadOwner")
  ownedDeals       Deal[]             @relation("DealOwner")
  assignedTasks    Task[]             @relation("TaskAssignee")
  notes            Note[]
  calls            Call[]
  conversations    Conversation[]
  notifications    Notification[]
  notificationPref NotificationPreference[]

  @@index([teamId])
  @@index([role])
  @@map("users")
}

model Session {
  id             String   @id @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  token          String   @unique
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  /// Better Auth ≥1.7: `local:<providerId>` for credential accounts, OAuth issuer URL otherwise
  issuer                String
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model TwoFactor {
  id                      String    @id @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

// ───────────────────────────── Organisation ─────────────────────────────

model Team {
  id        String   @id @db.Uuid
  name      String   @unique
  managerId String?  @map("manager_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  manager User?  @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members User[] @relation("TeamMembers")

  @@map("teams")
}

// ───────────────────────────── CRM core ─────────────────────────────

model Company {
  id           String    @id @db.Uuid
  name         String
  industry     String?
  website      String?
  phoneE164    String?   @map("phone_e164")
  email        String?   @db.Citext
  address      Json?
  ownerId      String?   @map("owner_id") @db.Uuid
  customFields Json      @default("{}") @map("custom_fields")
  createdById  String?   @map("created_by_id") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner    User?     @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts Contact[]
  deals    Deal[]
  tasks    Task[]
  notes    Note[]

  @@index([ownerId])
  @@index([phoneE164])
  @@index([deletedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "companies_name_trgm")
  @@map("companies")
}

model Contact {
  id               String    @id @db.Uuid
  firstName        String    @map("first_name")
  lastName         String?   @map("last_name")
  displayName      String    @map("display_name")
  companyId        String?   @map("company_id") @db.Uuid
  jobTitle         String?   @map("job_title")
  avatarKey        String?   @map("avatar_key")
  ownerId          String?   @map("owner_id") @db.Uuid
  source           String    @default("manual")
  tags             String[]  @default([])
  customFields     Json      @default("{}") @map("custom_fields")
  preferredChannel String?   @map("preferred_channel")
  doNotCall        Boolean   @default(false) @map("do_not_call")
  legalHold        Boolean   @default(false) @map("legal_hold")
  createdById      String?   @map("created_by_id") @db.Uuid
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// maintained by trigger contacts_search_vector_biu (migration SQL)
  searchVector     Unsupported("tsvector")? @map("search_vector")

  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner         User?          @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  phones        ContactPhone[]
  emails        ContactEmail[]
  deals         Deal[]
  tasks         Task[]
  notes         Note[]
  calls         Call[]
  conversations Conversation[]
  activities    Activity[]
  convertedFrom Lead[]         @relation("LeadConvertedContact")

  @@index([ownerId])
  @@index([companyId])
  @@index([deletedAt])
  @@index([tags], type: Gin)
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "contacts_display_name_trgm")
  @@index([searchVector], type: Gin, map: "contacts_search_idx")
  @@map("contacts")
}

model ContactPhone {
  id        String    @id @db.Uuid
  contactId String    @map("contact_id") @db.Uuid
  e164      String
  raw       String
  type      String    @default("mobile")
  isPrimary Boolean   @default(false) @map("is_primary")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // partial unique (e164) WHERE deleted_at IS NULL and (contact_id) WHERE is_primary — migration SQL
  @@index([contactId])
  @@index([e164])
  @@map("contact_phones")
}

model ContactEmail {
  id        String    @id @db.Uuid
  contactId String    @map("contact_id") @db.Uuid
  email     String    @db.Citext
  isPrimary Boolean   @default(false) @map("is_primary")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([email])
  @@map("contact_emails")
}

model CustomFieldDefinition {
  id        String   @id @db.Uuid
  entity    String
  key       String
  label     String
  type      String
  options   Json?
  required  Boolean  @default(false)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([entity, key])
  @@map("custom_field_definitions")
}

// ───────────────────────────── Sales ─────────────────────────────

model Pipeline {
  id        String   @id @db.Uuid
  name      String   @unique
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stages PipelineStage[]
  deals  Deal[]

  // partial unique (is_default) WHERE is_default — migration SQL
  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @db.Uuid
  pipelineId  String   @map("pipeline_id") @db.Uuid
  name        String
  sortOrder   Int      @default(0) @map("sort_order")
  probability Int      @default(0)
  type        String   @default("open")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  pipeline    Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]
  historyFrom DealStageHistory[] @relation("StageFrom")
  historyTo   DealStageHistory[] @relation("StageTo")

  @@unique([pipelineId, name])
  @@index([pipelineId, sortOrder])
  @@map("pipeline_stages")
}

model Lead {
  id                 String    @id @db.Uuid
  firstName          String    @map("first_name")
  lastName           String?   @map("last_name")
  companyName        String?   @map("company_name")
  phoneE164          String?   @map("phone_e164")
  phoneRaw           String?   @map("phone_raw")
  email              String?   @db.Citext
  source             String    @default("manual")
  sourceRef          String?   @map("source_ref")
  status             String    @default("new")
  ownerId            String?   @map("owner_id") @db.Uuid
  notes              String?
  customFields       Json      @default("{}") @map("custom_fields")
  convertedContactId String?   @map("converted_contact_id") @db.Uuid
  convertedDealId    String?   @map("converted_deal_id") @db.Uuid
  convertedAt        DateTime? @map("converted_at") @db.Timestamptz(3)
  createdById        String?   @map("created_by_id") @db.Uuid
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner            User?    @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedContact Contact? @relation("LeadConvertedContact", fields: [convertedContactId], references: [id], onDelete: SetNull)
  convertedDeal    Deal?    @relation("LeadConvertedDeal", fields: [convertedDealId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([phoneE164])
  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@map("leads")
}

model Deal {
  id                String    @id @db.Uuid
  title             String
  contactId         String?   @map("contact_id") @db.Uuid
  companyId         String?   @map("company_id") @db.Uuid
  pipelineId        String    @map("pipeline_id") @db.Uuid
  stageId           String    @map("stage_id") @db.Uuid
  value             Decimal   @default(0) @db.Decimal(14, 2)
  currency          String    @default("KES") @db.Char(3)
  probability       Int       @default(0)
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  ownerId           String?   @map("owner_id") @db.Uuid
  status            String    @default("open")
  wonAt             DateTime? @map("won_at") @db.Timestamptz(3)
  lostAt            DateTime? @map("lost_at") @db.Timestamptz(3)
  lostReason        String?   @map("lost_reason")
  customFields      Json      @default("{}") @map("custom_fields")
  createdById       String?   @map("created_by_id") @db.Uuid
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  contact       Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company       Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  pipeline      Pipeline           @relation(fields: [pipelineId], references: [id])
  stage         PipelineStage      @relation(fields: [stageId], references: [id])
  owner         User?              @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  history       DealStageHistory[]
  tasks         Task[]
  notes         Note[]
  activities    Activity[]
  convertedFrom Lead[]             @relation("LeadConvertedDeal")

  @@index([contactId])
  @@index([companyId])
  @@index([stageId])
  @@index([ownerId])
  @@index([status])
  @@index([expectedCloseDate])
  @@index([deletedAt])
  @@map("deals")
}

model DealStageHistory {
  id          String   @id @db.Uuid
  dealId      String   @map("deal_id") @db.Uuid
  fromStageId String?  @map("from_stage_id") @db.Uuid
  toStageId   String   @map("to_stage_id") @db.Uuid
  changedById String?  @map("changed_by_id") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  deal      Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage PipelineStage? @relation("StageFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage   PipelineStage  @relation("StageTo", fields: [toStageId], references: [id])

  @@index([dealId, changedAt])
  @@map("deal_stage_history")
}

// ───────────────────────────── Tasks & notes ─────────────────────────────

model Task {
  id             String    @id @db.Uuid
  title          String
  description    String?
  type           String    @default("follow_up")
  status         String    @default("open")
  priority       String    @default("normal")
  dueAt          DateTime? @map("due_at") @db.Timestamptz(3)
  remindAt       DateTime? @map("remind_at") @db.Timestamptz(3)
  reminderJobId  String?   @map("reminder_job_id")
  reminderSentAt DateTime? @map("reminder_sent_at") @db.Timestamptz(3)
  assigneeId     String?   @map("assignee_id") @db.Uuid
  contactId      String?   @map("contact_id") @db.Uuid
  dealId         String?   @map("deal_id") @db.Uuid
  companyId      String?   @map("company_id") @db.Uuid
  sourceCallId   String?   @map("source_call_id") @db.Uuid
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  createdById    String?   @map("created_by_id") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignee   User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal       Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sourceCall Call?    @relation(fields: [sourceCallId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status])
  @@index([dueAt])
  @@index([contactId])
  @@index([dealId])
  @@index([deletedAt])
  @@map("tasks")
}

model Note {
  id        String    @id @db.Uuid
  body      String
  authorId  String    @map("author_id") @db.Uuid
  contactId String?   @map("contact_id") @db.Uuid
  dealId    String?   @map("deal_id") @db.Uuid
  companyId String?   @map("company_id") @db.Uuid
  callId    String?   @map("call_id") @db.Uuid
  pinned    Boolean   @default(false)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  author      User         @relation(fields: [authorId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  call        Call?        @relation(fields: [callId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([contactId, createdAt])
  @@index([dealId, createdAt])
  @@index([companyId])
  @@index([callId])
  @@map("notes")
}

// ───────────────────────────── Telephony ─────────────────────────────

model CallDisposition {
  id        String   @id @db.Uuid
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  calls Call[]

  @@map("call_dispositions")
}

model Call {
  id                 String    @id @db.Uuid
  pbxCallId          String    @map("pbx_call_id")
  pbxCdrUid          String?   @unique @map("pbx_cdr_uid")
  direction          String
  status             String    @default("ringing")
  fromNumber         String    @map("from_number")
  toNumber           String    @map("to_number")
  externalE164       String?   @map("external_e164")
  contactId          String?   @map("contact_id") @db.Uuid
  userId             String?   @map("user_id") @db.Uuid
  extension          String?
  trunkName          String?   @map("trunk_name")
  didNumber          String?   @map("did_number")
  callPath           String?   @map("call_path")
  startedAt          DateTime  @map("started_at") @db.Timestamptz(3)
  answeredAt         DateTime? @map("answered_at") @db.Timestamptz(3)
  endedAt            DateTime? @map("ended_at") @db.Timestamptz(3)
  ringDurationSec    Int?      @map("ring_duration_sec")
  talkDurationSec    Int?      @map("talk_duration_sec")
  totalDurationSec   Int?      @map("total_duration_sec")
  dispositionId      String?   @map("disposition_id") @db.Uuid
  dispositionNote    String?   @map("disposition_note")
  dispositionSetById String?   @map("disposition_set_by_id") @db.Uuid
  dispositionSetAt   DateTime? @map("disposition_set_at") @db.Timestamptz(3)
  recordingFileName  String?   @map("recording_file_name")
  recordingStatus    String    @default("none") @map("recording_status")
  recordingKey       String?   @map("recording_key")
  recordingSizeBytes BigInt?   @map("recording_size_bytes")
  recordingSha256    String?   @map("recording_sha256")
  pbxRawCdr          Json?     @map("pbx_raw_cdr")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  contact     Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  disposition CallDisposition? @relation(fields: [dispositionId], references: [id], onDelete: SetNull)
  notes       Note[]
  tasks       Task[]

  @@index([pbxCallId])
  @@index([contactId, startedAt(sort: Desc)])
  @@index([userId, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@index([externalE164])
  @@index([status])
  @@map("calls")
}

// ───────────────────────────── Messaging ─────────────────────────────

model Channel {
  id               String   @id @db.Uuid
  type             String
  name             String
  externalId       String?  @map("external_id")
  config           Json     @default("{}")
  secretsEncrypted Bytes?   @map("secrets_encrypted")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversations Conversation[]

  @@unique([type, externalId])
  @@map("channels")
}

model Conversation {
  id            String    @id @db.Uuid
  channelId     String    @map("channel_id") @db.Uuid
  contactId     String?   @map("contact_id") @db.Uuid
  externalId    String    @map("external_id")
  status        String    @default("open")
  assigneeId    String?   @map("assignee_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  lastInboundAt DateTime? @map("last_inbound_at") @db.Timestamptz(3)
  unreadCount   Int       @default(0) @map("unread_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  channel  Channel   @relation(fields: [channelId], references: [id])
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignee User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([channelId, externalId])
  @@index([contactId])
  @@index([assigneeId, status])
  @@index([lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id                String    @id @db.Uuid
  conversationId    String    @map("conversation_id") @db.Uuid
  direction         String
  externalMessageId String?   @map("external_message_id")
  contentType       String    @default("text") @map("content_type")
  body              String?
  status            String    @default("received")
  errorCode         String?   @map("error_code")
  errorMessage      String?   @map("error_message")
  sentById          String?   @map("sent_by_id") @db.Uuid
  sentAt            DateTime  @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz(3)
  readAt            DateTime? @map("read_at") @db.Timestamptz(3)
  raw               Json?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  Attachment[]

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, sentAt])
  @@map("messages")
}

/// Where an object key lives when the backend cannot address it by key (Google Drive names
/// files by id). One row per stored object; the local S3 store needs none.
model StorageObject {
  key         String   @id
  provider    String
  providerId  String   @map("provider_id")
  sizeBytes   BigInt   @map("size_bytes")
  contentType String   @map("content_type")
  sha256      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([provider, providerId])
  @@map("storage_objects")
}

model Attachment {
  id           String   @id @db.Uuid
  key          String   @unique
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    BigInt   @map("size_bytes")
  sha256       String?
  messageId    String?  @map("message_id") @db.Uuid
  noteId       String?  @map("note_id") @db.Uuid
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  note    Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([noteId])
  @@map("attachments")
}

// ───────────────────────────── Timeline, audit, notifications ─────────────────────────────

model Activity {
  id           String   @id @db.Uuid
  type         String
  contactId    String?  @map("contact_id") @db.Uuid
  dealId       String?  @map("deal_id") @db.Uuid
  companyId    String?  @map("company_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(3)
  summary      String
  refTable     String   @map("ref_table")
  refId        String   @map("ref_id") @db.Uuid
  meta         Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// generated column (migration SQL): to_tsvector('simple', summary || ' ' || meta->>'text')
  searchVector Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([contactId, occurredAt(sort: Desc)])
  @@index([dealId, occurredAt(sort: Desc)])
  @@index([companyId, occurredAt(sort: Desc)])
  @@index([refTable, refId])
  @@index([searchVector], type: Gin, map: "activities_search_idx")
  @@map("activities")
}

model AuditLog {
  id        String   @id @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  actorType String   @default("user") @map("actor_type")
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.Uuid
  before    Json?
  after     Json?
  ip        String?
  userAgent String?  @map("user_agent")
  requestId String?  @map("request_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  userId String  @map("user_id") @db.Uuid
  type   String
  inApp  Boolean @default(true) @map("in_app")
  email  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("notification_preferences")
}

// ───────────────────────────── Integration & ops ─────────────────────────────

model PbxEvent {
  id          String    @id @db.Uuid
  eventType   Int       @map("event_type")
  pbxCallId   String?   @map("pbx_call_id")
  sn          String?
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  error       String?

  @@index([pbxCallId])
  @@index([receivedAt])
  @@map("pbx_events")
}

model WebForm {
  id               String   @id @db.Uuid
  name             String
  token            String   @unique
  fields           Json     @default("[]")
  allowedOrigins   String[] @default([]) @map("allowed_origins")
  defaultOwnerId   String?  @map("default_owner_id") @db.Uuid
  isActive         Boolean  @default(true) @map("is_active")
  submissionsCount Int      @default(0) @map("submissions_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("web_forms")
}

model ImportJob {
  id            String    @id @db.Uuid
  entity        String
  fileKey       String    @map("file_key")
  status        String    @default("queued")
  totalRows     Int       @default(0) @map("total_rows")
  processedRows Int       @default(0) @map("processed_rows")
  createdRows   Int       @default(0) @map("created_rows")
  updatedRows   Int       @default(0) @map("updated_rows")
  errorRows     Int       @default(0) @map("error_rows")
  errors        Json      @default("[]")
  mapping       Json      @default("{}")
  createdById   String    @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([createdById, createdAt])
  @@map("import_jobs")
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

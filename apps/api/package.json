{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CRM backend — Fastify API + worker (Yeastar CTI, jobs)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/entry/api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/entry/worker.ts",
    "build": "pnpm prisma:generate && tsc --noEmit && tsup",
    "start": "node --enable-source-maps dist/entry/api.js",
    "start:worker": "node --enable-source-maps dist/entry/worker.js",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "openapi:export": "tsx --env-file-if-exists=../../.env src/scripts/export-openapi.ts",
    "dev:user": "tsx --env-file-if-exists=../../.env src/scripts/dev-create-user.ts",
    "dev:seed-demo": "tsx --env-file-if-exists=../../.env src/scripts/dev-seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1124.0",
    "@aws-sdk/s3-request-presigner": "3.1124.0",
    "@crm/shared": "workspace:*",
    "@fast-csv/format": "5.0.7",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/under-pressure": "9.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "better-auth": "1.7.2",
    "bullmq": "6.3.4",
    "date-fns": "4.4.0",
    "fastify": "5.12.1",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "file-type": "22.0.2",
    "ioredis": "5.11.1",
    "libphonenumber-js": "1.13.12",
    "nodemailer": "9.1.1",
    "openapi-types": "12.1.3",
    "papaparse": "5.7.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "socket.io": "4.8.3",
    "undici": "7.29.0",
    "uuid": "14.0.2",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/nodemailer": "8.0.1",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "17.4.2",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "socket.io-client": "4.8.3",
    "testcontainers": "12.1.0",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}

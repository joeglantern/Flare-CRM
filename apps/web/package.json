{
  "name": "@crm/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Flare CRM web client (Vite + React)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "openapi:types": "openapi-typescript ../../docs/openapi.json -o src/lib/api/schema.d.ts --root-types --alphabetize",
    "brand": "node scripts/build-brand-assets.mjs",
    "help:figures": "node scripts/capture-help-figures.mjs"
  },
  "dependencies": {
    "@crm/shared": "workspace:*",
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-virtual": "3.14.10",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.39.0",
    "openapi-fetch": "0.17.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "socket.io-client": "4.8.3",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@crm/tsconfig": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/router-plugin": "1.168.35",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.13.2",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
